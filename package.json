{
  "name": "avi-workspace-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel styles:watch dev:vite",
    "dev:vite": "vite",
    "styles": "cascadium build -d styles -x .xcss -o src/styles.css --p:pretty true --p:filenametag relative",
    "styles:watch": "cascadium watch -d styles -x .xcss -o src/styles.css --p:pretty true --p:filenametag relative",
    "test": "bun test",
    "build": "bun run styles && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.2",
    "dompurify": "^3.2.7",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.18.7",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "preact": "^10.27.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remixicon": "^4.6.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@cypherpotato/cascadium": "^1.2.0",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^20.12.0",
    "vite": "^7.1.7"
  }
}