.workspace { position: relative; height: 100%; display: grid; grid-template-columns: var(--sidebar-width) minmax(320px, 1fr) var(--panel-width); grid-template-rows: minmax(0, 1fr) 22px; overflow: hidden;
  &.sidebar-collapsed { grid-template-columns: 58px minmax(320px, 1fr) var(--panel-width); }
  &:not(.panel-open) { grid-template-columns: var(--sidebar-width) minmax(320px, 1fr); }
  &.sidebar-collapsed:not(.panel-open) { grid-template-columns: 58px minmax(320px, 1fr); }
  > .panel-resizer { position: absolute; z-index: 8; top: 0; bottom: 22px; width: 8px; cursor: col-resize; touch-action: none; user-select: none; background: transparent; &:hover, &:focus-visible { background: --primary-color-opaque; outline: 1px solid --primary-color; } &.sidebar-resizer { left: calc(var(--sidebar-width) - 4px); } &:not(.sidebar-resizer) { right: calc(var(--panel-width) - 4px); } }
  > .version-bar { grid-column: 1 / -1; display: flex; align-items: center; justify-content: flex-end; padding: 0 10px; border-top: 1px solid --border-color; background: --background-secondary; color: --text-muted; font: 10px/1 --font-code; }
}
.sidebar { position: relative; min-width: 0; display: grid; grid-template-rows: 48px minmax(0, 1fr) 48px; border-right: 1px solid --border-color; background: --background-secondary; font-size: 1rem;
  > header { display: flex; align-items: center; justify-content: space-between; padding: 0 12px; button { width: 32px; height: 32px; border-radius: 6px; background: transparent; } button:hover { background: --item-hover; } }
  > nav { min-height: 0; overflow: auto; scrollbar-width: thin; padding: 4px 6px 12px; }
  > .sidebar-feedback { position: absolute; z-index: 5; right: 8px; bottom: 48px; left: 8px; margin: 0; padding: 10px; border: 1px solid --border-color; border-radius: 6px; background: --background-elevated; color: --success-color; font-size: 12px; overflow-wrap: anywhere; &.is-error { color: --danger-color; } }
  > footer { padding: 7px 8px; border-top: 1px solid --border-color; button { width: 100%; height: 34px; display: flex; align-items: center; gap: 10px; padding: 0 9px; border-radius: 6px; background: transparent; text-align: left; } button:hover { background: --item-hover; } }
}
.avi-mark { display: inline-flex; align-items: center; gap: 7px; color: --text-primary; font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; opacity: .62; > img { width: 22px; height: 22px; border-radius: 6px; object-fit: contain; } &.large { gap: 0; opacity: 1; > img { width: 34px; height: 34px; } } }
.new-chat-control { position: relative; }
.nav-action { width: 100%; height: 32px; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-radius: 6px; background: transparent; text-align: left; &:hover, &:focus-visible { background: --item-hover; } > span { flex: 1; } .nav-action-chevron { color: --text-muted; } &.ghost { margin-top: 2px; background: transparent; color: --text-secondary; &:hover, &:focus-visible { background: --item-hover; color: --text-primary; } } }
.sidebar-popover { position: fixed; z-index: 30; max-height: calc(100dvh - 16px); overflow: auto; }
.folder-picker { width: min(300px, calc(100vw - 24px)); max-height: min(360px, calc(100dvh - 16px)); padding: 6px; border: 1px solid --border-color; border-radius: 8px; background: --background-elevated; box-shadow: 0 12px 32px rgb(0 0 0 / .32); > strong { display: block; padding: 5px 8px 7px; color: --text-muted; font-size: 10px; text-transform: uppercase; letter-spacing: .06em; } > button { width: 100%; min-width: 0; display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 5px; background: transparent; text-align: left; > i { color: --text-muted; } > span { min-width: 0; display: grid; gap: 2px; b, small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } b { font-size: --font-sm; font-weight: 550; } small { color: --text-muted; font-size: --font-xs; } } } > button:hover, > button:focus-visible { background: --item-hover; } }
.nav-section { margin-top: 16px; padding-top: 8px; border-top: 1px solid --border-color; }
.conversation-folder { margin-top: 8px; &:first-of-type { margin-top: 4px; } > header { min-width: 0; display: flex; align-items: center; gap: 2px; padding: 0 2px 2px; > button { height: 28px; border-radius: 5px; background: transparent; color: --text-muted; } > button:hover { background: --item-hover; color: --text-primary; } .folder-toggle { min-width: 0; flex: 1; display: flex; align-items: center; gap: 6px; padding: 0 6px; text-align: left; > span { overflow: hidden; color: --text-secondary; font-size: .9rem; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; } } .folder-new-chat { width: 28px; padding: 0; opacity: 0; } } &:hover > header .folder-new-chat, &:focus-within > header .folder-new-chat { opacity: 1; } > .thread-list { padding-left: 0; } > .show-more { margin-left: 16px; width: calc(100% - 20px); } }
.sidebar-empty { padding: 12px 8px; color: --text-muted; font-size: 12px; }
.thread-list { margin: 0; padding: 0; list-style: none;
  > li { position: relative; min-width: 0; display: flex; align-items: center; > button:first-child { width: 100%; min-width: 0; min-height: 32px; display: flex; align-items: center; gap: 8px; padding: 4px 8px 4px 28px; border-radius: 6px; background: transparent; text-align: left; > span { min-width: 0; flex: 1; display: block; strong, small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } strong { display: block; font-size: 1rem; font-weight: 400; } } } > button:first-child:hover { background: --item-hover; } > .thread-rename { position: absolute; right: 3px; width: 28px; height: 28px; border-radius: 5px; background: transparent; color: --text-muted; opacity: 0; } &:hover > .thread-rename, &:focus-within > .thread-rename { opacity: 1; } }
  > li.active > button:first-child { background: --item-active; }
  &.compact > li > button:first-child { padding-block: 5px; }
}
.sidebar-menu { width: 220px; padding: 5px; border: 1px solid --border-color; border-radius: 8px; background: --background-elevated; box-shadow: 0 12px 32px rgb(0 0 0 / .38); }
.menu-item { width: 100%; min-height: 34px; display: flex; align-items: center; gap: 8px; padding: 7px 9px; border-radius: 6px; background: transparent; color: --text-secondary; font-size: --font-sm; text-align: left; &:hover, &.checked { background: --item-hover; color: --text-primary; } &.danger { color: --danger-color; } > span:last-child { min-width: 0; flex: 1; } }
.menu-divider { margin: 4px; border: 0; border-top: 1px solid --border-color; }
.menu-label, .menu-empty { padding: 5px 9px; color: --text-muted; font-size: 9px; text-transform: uppercase; }
.tag-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; }
.sidebar-section-header { position: relative; min-height: 32px; display: flex; align-items: center; padding: 0 2px 4px 8px; > strong { min-width: 0; flex: 1; display: flex; align-items: center; gap: 6px; color: --text-muted; font-size: .9rem; font-weight: 400; > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } > small { color: --text-muted; font-size: 9px; font-weight: 500; letter-spacing: 0; } } }
.section-actions { display: flex; gap: 2px; }
.section-action { width: 28px; height: 28px; border-radius: 5px; background: transparent; color: --text-muted; &:hover, &.active, &[aria-expanded="true"] { background: --item-hover; color: --text-primary; } }
.bot-list { margin: 0; padding: 0; list-style: none; }
.bot-row { position: relative; min-height: 36px; display: flex; align-items: center; border-radius: 6px; &:hover, &:focus-within { background: --item-hover; } &.active { background: --item-active; } }
.bot-open { min-width: 0; flex: 1; min-height: 36px; display: flex; align-items: center; gap: 9px; padding: 5px 8px; background: transparent; text-align: left; > .bot-avatar { flex: 0 0 22px; border-radius: 50%; } > span { min-width: 0; flex: 1; display: block; > strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 1rem; font-weight: 400; } } }
.bot-status { width: 22px; flex: 0 0 22px; text-align: center; color: --success-color; font-size: .5rem; &.disabled, &.sleep { color: --text-muted; font-size: .9rem; } &.working { color: --text-secondary; font-size: 1rem; } }
.bot-attention { min-width: 18px; height: 18px; display: grid; place-items: center; padding: 0 4px; border-radius: 999px; background: --danger-color; color: --background-primary; font-size: .9rem; font-weight: 500; }
.bot-menu, .thread-menu { width: 30px; height: 30px; flex: 0 0 auto; border-radius: 5px; background: transparent; color: --text-muted; opacity: 0; }
.bot-row:hover > .bot-menu, .bot-row:focus-within > .bot-menu, .bot-row.menu-open > .bot-menu, .thread-list > li:hover > .thread-menu, .thread-list > li:focus-within > .thread-menu, .thread-list > li.menu-open > .thread-menu { opacity: 1; }
.thread-list > li { > .thread-open { padding-right: 36px; > .thread-status { position: absolute; right: 8px; width: 22px; flex: 0 0 22px; text-align: center; font-size: .9rem; } } > .thread-menu { position: absolute; right: 3px; } &:hover, &:focus-within, &.menu-open { .thread-status { visibility: hidden; } } }
.bot-row { > .bot-open { padding-right: 36px; > .bot-status, > .bot-attention { position: absolute; right: 8px; } } > .bot-menu { position: absolute; right: 3px; } &:hover, &:focus-within, &.menu-open { .bot-status, .bot-attention { visibility: hidden; } } }
.thread-status.approval, .thread-status.input, .thread-status.blocked, .thread-status.attention { color: --warn-color; } .thread-status.working { color: --text-secondary; } .thread-status.completed { color: --success-color; }
.row-tag-dots { display: inline-flex; gap: 3px; margin-left: 5px; }
.agent-thread-icon { margin-left: 5px; color: --text-muted; font-size: 10px; }
.task-group { margin-top: 8px; padding: 0 0 5px; > .thread-list { display: grid; gap: 1px; } }
.show-more { width: 100%; min-height: 30px; display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 3px; padding: 0 8px 0 32px; border-radius: 6px; background: transparent; color: --text-muted; font-size: 12px; text-align: left; transition: background --duration-fast --ease-smooth-out, color --duration-fast --ease-smooth-out; &:hover, &:focus-visible { background: --item-hover; color: --text-primary; } > i { font-size: 14px; } }
.folders-header { margin-top: 18px; }
.task-group > .sidebar-section-header > strong > small { display: none; }
.conversation-folder { position: relative; > header { position: relative; .folder-color { position: relative; width: 27px; padding: 0; opacity: 0; > .tag-dot { position: absolute; right: 2px; bottom: 2px; } } } &:hover > header .folder-color, &:focus-within > header .folder-color { opacity: 1; } }
.color-menu { width: 210px; } .palette-row { display: grid; grid-template-columns: repeat(4, 30px); gap: 6px; padding: 7px; } .color-swatch { width: 30px; height: 30px; border: 2px solid transparent; border-radius: 50%; &.active { border-color: --text-primary; } }
.sidebar-dialog-backdrop { position: fixed; z-index: 40; inset: 0; display: grid; place-items: center; padding: 20px; background: rgb(0 0 0 / .62); }
.sidebar-dialog { width: min(520px, 100%); max-height: min(680px, calc(100dvh - 40px)); display: flex; flex-direction: column; overflow: hidden; border: 1px solid --border-color; border-radius: 12px; background: --background-secondary; box-shadow: 0 24px 72px rgb(0 0 0 / .48); > header { display: flex; align-items: center; justify-content: space-between; padding: 15px 16px; border-bottom: 1px solid --border-color; h2 { margin: 0; font-size: --font-lg; } button { width: 34px; height: 34px; border-radius: 6px; background: transparent; } } }
.dialog-search { position: relative; display: flex; align-items: center; gap: 8px; margin: 14px; padding: 0 10px; border: 1px solid --border-color; border-radius: 8px; background: --background-tertiary; &:focus-within { border-color: --primary-color; } input { min-width: 0; flex: 1; height: 42px; border: 0; background: transparent; } input:focus-visible { outline: 0; } kbd { color: --text-muted; font-size: 10px; } }
.search-error { display: flex; align-items: center; gap: 8px; padding: 12px 16px; color: --danger-color; font-size: 12px; > span { flex: 1; min-width: 0; overflow-wrap: anywhere; } > button { flex: 0 0 auto; min-height: 36px; padding: 4px 10px; border-radius: 4px; background: --item-hover; } }
.dialog-error { margin: 0; color: --danger-color; font-size: 12px; overflow-wrap: anywhere; }
.prompt-description { margin: 0; color: --text-secondary; line-height: 1.5; overflow-wrap: anywhere; }
.prompt-form > footer > .danger { background: --danger-color; color: --background-primary; }
.dialog-body { min-height: 0; overflow: auto; display: grid; gap: 10px; padding: 16px; > label { display: grid; gap: 5px; color: --text-secondary; font-size: --font-sm; input, select { min-height: 38px; padding: 0 9px; border: 1px solid --border-color; border-radius: 7px; background: --background-tertiary; } &.check { display: flex; align-items: center; gap: 7px; input { min-height: 0; } } } > footer, + footer { display: flex; justify-content: flex-end; gap: 7px; } }
.sidebar-dialog > footer, .bot-form > footer { display: flex; justify-content: flex-end; gap: 7px; padding: 12px 16px; border-top: 1px solid --border-color; button { min-height: 34px; padding: 0 12px; border-radius: 6px; background: --item-hover; } button.primary { background: --primary-color; } }
.tag-row { display: grid; grid-template-columns: 38px minmax(0, 1fr) 34px; gap: 7px; input { min-width: 0; min-height: 36px; padding: 0 8px; border: 1px solid --border-color; border-radius: 6px; background: --background-tertiary; } .tag-color { padding: 3px; } .tag-remove { border-radius: 6px; background: --item-hover; color: --danger-color; } }
.dialog-secondary { justify-self: start; min-height: 34px; padding: 0 10px; border-radius: 6px; background: --item-hover; } .dialog-empty { color: --text-muted; }
.search-results { min-height: 100px; overflow: auto; display: grid; align-content: start; padding: 0 10px 12px; > .search-results-label { display: flex; justify-content: space-between; padding: 7px 9px; color: --text-muted; font-size: 10px; } > button { width: 100%; display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 9px; padding: 10px; border-radius: 7px; background: transparent; text-align: left; &:hover, &.active, &[aria-selected="true"] { background: --item-hover; } } }
.search-result-copy { min-width: 0; display: grid; gap: 4px; } .search-result-heading { display: flex; gap: 8px; strong { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } small, .search-result-age { color: --text-muted; font-size: 10px; } } .search-result-preview { overflow: hidden; color: --text-secondary; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; } .search-empty { display: grid; justify-items: center; gap: 7px; padding: 30px; color: --text-muted; }
.workspace.sidebar-collapsed > .sidebar { overflow: hidden;
  > header { justify-content: center; padding-inline: 0; border-bottom-color: transparent; > .avi-mark { display: none; } > button { flex: 0 0 36px; width: 36px; height: 36px; padding: 0; display: grid; place-items: center; } }
  > nav { padding: 4px 10px; scrollbar-gutter: auto; > .nav-section, > .instance-bar { display: none; } .nav-action { width: 36px; height: 36px; justify-content: center; gap: 0; padding: 0; background: transparent; color: --text-secondary; > span, > .nav-action-chevron { display: none; } > i { width: 20px; line-height: 20px; text-align: center; font-size: 18px; } &:hover, &:focus-visible { background: --item-hover; color: --text-primary; } } }
  > footer { padding: 7px 10px; border-top-color: transparent; > button { width: 36px; height: 36px; justify-content: center; gap: 0; padding: 0; > span { display: none; } > i { width: 20px; line-height: 20px; text-align: center; font-size: 18px; } } }
}
.chat-area { position: relative; min-width: 0; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background: --background-primary; }
.mobile-drawer, .mobile-overlay-backdrop { display: none; }
.mobile-navigation-layer { position: fixed; z-index: 20; inset: 0; }
.workspace-header { flex: 0 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) 32px; align-items: center; gap: 8px; padding: 4px 12px; border-bottom: 1px solid --border-color; background: --background-primary;
  > .navigation-trigger { display: none; }
  > .workspace-heading { min-width: 0; display: flex; align-items: baseline; gap: 10px; strong, small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } strong { font-size: 14px; font-weight: 600; } small { color: --text-muted; font-size: 11px; } }
  > button { position: relative; width: 32px; height: 32px; border-radius: 6px; background: transparent; font-size: 18px; &:hover { background: --item-hover; } > b { position: absolute; top: 0; right: 0; min-width: 16px; padding: 2px 4px; border-radius: 4px; background: --warn-color; color: --background-primary; font-size: 10px; } }
}
.sidebar > nav {
  > .instance-bar { margin-bottom: 10px; min-width: 0; display: flex; align-items: center; gap: 8px; color: --text-secondary; font-size: .9rem;
    > select { min-width: 0; flex: 1; width: 0; padding: 6px; border: 1px solid --border-color; border-radius: 4px; background: --background-secondary; }
    > .instance-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    > .instance-status { min-width: 0; flex: 0 0 auto; max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-transform: capitalize; &.online { color: --success-color; } &.offline, &.error { color: --danger-color; } }
  }
}
.workspace-connection-alert { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; padding: 8px 16px; background: --background-secondary; color: --warn-color; font-size: 12px; > span { flex: 1; min-width: 0; overflow-wrap: anywhere; } > button { flex: 0 0 auto; min-height: 32px; padding: 4px 8px; border-radius: 4px; background: --item-hover; } }
.conversation-scroll { min-height: 0; flex: 1; overflow: auto; padding: 28px 20px calc(var(--composer-clearance, 226px) + 54px); scroll-behavior: smooth; }
.messages-column { width: min(820px, 100%); margin: auto; display: grid; gap: 22px; }
.load-older { display: block; margin: 0 auto 24px; padding: 7px 12px; border-radius: 6px; background: --item-hover; color: --text-secondary; }
.empty-chat { min-height: 65vh; display: grid; place-content: center; justify-items: center; text-align: center; h1 { margin: 18px 0 5px; font-size: 23px; font-weight: 560; } p { margin: 0; color: --text-secondary; } }
.scroll-to-bottom { position: absolute; z-index: 4; left: 50%; bottom: calc(var(--composer-clearance, 226px) + 28px); width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid --border-color; border-radius: 50%; background: --background-elevated; color: --text-secondary; box-shadow: 0 8px 24px rgb(0 0 0 / .32); transform: translateX(-50%); transition: background --duration-fast --ease-smooth-out, color --duration-fast --ease-smooth-out, transform --duration-fast --ease-smooth-out; &:hover, &:focus-visible { background: --item-hover; color: --text-primary; transform: translateX(-50%) translateY(-2px); } > i { font-size: 18px; } }
.open-panel { position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 6px; background: --background-secondary; }
.auxiliary-panel { min-width: 0; min-height: 0; display: grid; grid-template-rows: 44px minmax(0, 1fr); border-left: 1px solid --border-color; background: --background-secondary; font-size: 12px;
  > header { min-width: 0; display: flex; align-items: center; gap: 2px; padding: 5px 6px; border-bottom: 1px solid --border-color; > div { min-width: 0; display: flex; align-items: center; gap: 2px; overflow-x: auto; } button { height: 32px; padding: 0 9px; border-radius: 5px; background: transparent; color: --text-secondary; white-space: nowrap; } button[aria-selected="true"] { background: --item-active; color: --text-primary; } button > b { margin-left: 5px; color: --warn-color; } .close-panel { margin-left: auto; padding: 0; min-width: 32px; }
  }
  > .aux-content { min-height: 0; overflow: auto; padding: 12px; }
}
.panel-empty { padding: 36px 14px; color: --text-muted; text-align: center; }
.queue-list, .semaphore-list { margin-bottom: 16px; > h2 { margin: 0 0 7px; color: --text-muted; font-size: 11px; text-transform: uppercase; } > div { display: flex; align-items: center; gap: 5px; padding: 8px; border-bottom: 1px solid --border-color; > span { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } > span:has(small) { display: grid; gap: 2px; small { color: --text-muted; } } > button { min-width: 28px; min-height: 28px; padding: 5px 7px; border-radius: 4px; background: --item-hover; color: --text-secondary; } > button:last-child { color: --danger-color; } } }
.task-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; > li { display: flex; gap: 10px; padding: 10px 8px; border-bottom: 1px solid --border-color; > i { color: --text-muted; } strong { font-size: --font-xs; } p { margin: 4px 0; color: --text-secondary; font-size: --font-xs; } small { color: --text-muted; } &.done { opacity: .65; } &.done > i { color: --success-color; } } }
.attention-card { margin-bottom: 10px; padding: 12px; border: 1px solid --border-color; border-radius: 7px; background: --background-primary;
  > header { display: flex; gap: 9px; > i { color: --warn-color; } div { display: grid; } small { color: --text-secondary; } }
  > pre { max-height: 180px; overflow: auto; padding: 8px; background: --background-tertiary; font-size: 10px; white-space: pre-wrap; }
  > footer { display: flex; justify-content: flex-end; gap: 6px; margin-top: 10px; button { height: 30px; padding: 0 10px; border-radius: 5px; background: --item-hover; } button.primary { background: --primary-color; } }
  &.question > fieldset { display: grid; gap: 7px; margin: 12px 0 0; padding: 0; border: 0; color: --text-secondary; font-size: --font-xs; legend { margin-bottom: 7px; color: --text-primary; font-weight: 600; } label { display: flex; align-items: center; gap: 7px; } input[type="text"] { min-height: 34px; padding: 0 8px; border: 1px solid --border-color; border-radius: 5px; background: --background-tertiary; } }
}
@media (max-width: 860px) {
  .workspace, .workspace:not(.panel-open), .workspace.panel-open, .workspace.sidebar-collapsed, .workspace.sidebar-collapsed:not(.panel-open) { grid-template-columns: minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }
  .workspace > .sidebar, .workspace > .version-bar, .workspace > .panel-resizer { display: none; }
  .workspace-header > .workspace-heading { display: block; > small { display: none; } }
  .chat-area { grid-column: 1; }
  .mobile-header { z-index: 4; min-height: calc(44px + env(safe-area-inset-top)); display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; align-items: end; gap: 6px; padding: env(safe-area-inset-top) 6px 0; border-bottom: 1px solid --border-color; background: --background-primary; > button { position: relative; width: 44px; height: 44px; border-radius: 8px; background: transparent; color: --text-primary; font-size: 18px; &:hover { background: --item-hover; } > b { position: absolute; top: 3px; right: 2px; min-width: 16px; height: 16px; display: grid; place-items: center; padding: 0 4px; border-radius: 999px; background: --warn-color; color: --background-primary; font-size: 9px; } } > div { min-width: 0; align-self: center; display: grid; gap: 2px; text-align: center; strong, small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } strong { font-size: 13px; font-weight: 600; } small { color: --text-muted; font-size: 10px; } } }
  .workspace-header > .navigation-trigger { display: block; }
  .conversation-scroll { padding: 22px 12px calc(var(--composer-clearance, 134px) + 24px + var(--safe-bottom)); }
  .scroll-to-bottom { bottom: calc(var(--composer-clearance, 134px) + 16px + var(--safe-bottom)); }
  .mobile-overlay-backdrop { position: fixed; z-index: 20; inset: 0; display: block; padding: 0; border: 0; border-radius: 0; background: rgb(0 0 0 / .58); }
  .sidebar-popover { z-index: 50; top: calc(var(--app-offset-top) + env(safe-area-inset-top) + (var(--app-height) - env(safe-area-inset-top) - var(--safe-bottom)) / 2) !important; left: 50% !important; width: min(360px, calc(100vw - 24px - env(safe-area-inset-left) - env(safe-area-inset-right))); max-height: calc(var(--app-height) - 24px - env(safe-area-inset-top) - var(--safe-bottom)); transform: translate(-50%, -50%); }
  .mobile-drawer { position: fixed; z-index: 21; top: 50%; left: 50%; width: min(420px, calc(100vw - 24px)); height: min(680px, calc(var(--app-height) - 24px - env(safe-area-inset-top) - var(--safe-bottom))); display: block; overflow: hidden; border: 1px solid --border-color; border-radius: 14px; background: --background-secondary; box-shadow: 0 24px 72px rgb(0 0 0 / .48); transform: translate(-50%, -50%); .sidebar { width: 100%; height: 100%; display: grid; grid-template-rows: 48px minmax(0, 1fr) 48px; border: 0; span, label { display: initial; } .folder-conversations, .bots-section { display: block; } .nav-action { justify-content: flex-start; } .folder-new-chat, .folder-color, .thread-menu, .bot-menu { width: 44px; height: 44px; opacity: 1; } .thread-open, .bot-open { min-height: 44px; padding-right: 74px; > .thread-status, > .bot-status, > .bot-attention { right: 48px; visibility: visible; } } .nav-action { min-height: 44px; } } }
  .sidebar-dialog-backdrop { z-index: 45; top: --app-offset-top; bottom: auto; height: --app-height; padding: calc(12px + env(safe-area-inset-top)) calc(12px + env(safe-area-inset-right)) calc(12px + var(--safe-bottom)) calc(12px + env(safe-area-inset-left)); }
  .sidebar-dialog { width: min(520px, 100%); height: auto; max-height: 100%; padding: 0; border: 1px solid --border-color; border-radius: 14px; &.search-dialog .search-results { min-height: 0; } > header > button { width: 44px; height: 44px; } > footer button, .dialog-add { min-height: 44px; } }
  .auxiliary-panel { position: fixed; z-index: 22; top: 50%; right: auto; bottom: auto; left: 50%; width: min(520px, calc(100vw - 24px)); height: min(680px, calc(var(--app-height) - 24px - env(safe-area-inset-top) - var(--safe-bottom))); min-width: 0; overflow: hidden; border: 1px solid --border-color; border-radius: 14px; box-shadow: 0 0 0 100vmax rgb(0 0 0 / .58), 0 24px 72px rgb(0 0 0 / .48); transform: translate(-50%, -50%); grid-template-rows: 48px minmax(0, 1fr); > header { align-items: center; padding: 4px 6px; button { min-height: 40px; } .close-panel { min-width: 44px; height: 44px; } } > .aux-content { padding-bottom: 12px; } }
  .mobile-drawer, .auxiliary-panel { top: calc(var(--app-offset-top) + env(safe-area-inset-top) + (var(--app-height) - env(safe-area-inset-top) - var(--safe-bottom)) / 2); max-width: calc(100vw - 24px - env(safe-area-inset-left) - env(safe-area-inset-right)); }
  .mobile-drawer .sidebar { > header button, > footer button { min-height: 44px; } > header button { min-width: 44px; } > footer { padding-block: 2px; } > nav { overscroll-behavior: contain; > .instance-bar select { min-height: 44px; } } .section-heading > button, .folder-heading > button { min-width: 44px; min-height: 44px; } }
  .empty-chat { min-height: calc(var(--app-height) / 2); }
}
@media (max-width: 640px) {
  .mobile-drawer, .auxiliary-panel { top: --app-offset-top; right: 0; left: 0; width: 100%; max-width: none; height: --app-height; padding: env(safe-area-inset-top) env(safe-area-inset-right) var(--safe-bottom) env(safe-area-inset-left); border: 0; border-radius: 0; box-shadow: none; transform: none; }
}
@media (max-width: 380px) { .conversation-scroll { padding-inline: 10px; } }
