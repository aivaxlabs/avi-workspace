:root {
  color-scheme: dark;
  --font-ui: "Segoe UI Variable", "Segoe UI", sans-serif;
  --font-code: "Cascadia Code", "SFMono-Regular", monospace;
  --font-xl: 18px;
  --font-lg: 16.8px;
  --font-md: 16px;
  --font-sm: 14.4px;
  --font-xs: 12.96px;
  --background-primary: #18191b;
  --background-secondary: #202124;
  --background-tertiary: #292a2e;
  --background-elevated: #303136;
  --text-primary: #ececee;
  --text-secondary: #a9abb2;
  --text-muted: #a0a3ab;
  --border-color: #34363b;
  --item-hover: #292b2f;
  --item-active: #34363b;
  --primary-color: #8aa7ff;
  --success-color: #66c58a;
  --warn-color: #e0aa61;
  --danger-color: #ee7d7d;
  --sidebar-width: 222px;
  --panel-width: min(420px, 38vw);
  --duration-fast: 160ms;
  --ease-smooth-out: cubic-bezier(.2,.8,.2,1);
  font-family: --font-ui;
  font-size: 14px;
}

* { box-sizing: border-box; }
html, body, #app { width: 100%; height: 100%; margin: 0; }
body { overflow: hidden; background: --background-primary; color: --text-primary; }
button, input, textarea, select { color: inherit; font: inherit; }
button { border: 0; cursor: pointer; }
button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid --primary-color; outline-offset: 2px; }
button:disabled { cursor: not-allowed; opacity: .45; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
code, pre, kbd { font-family: --font-code; }
.primary { background: --primary-color; color: #11131a; font-weight: 650; }
.error-banner, .inline-error { color: --danger-color; }
.spinning { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; } }
